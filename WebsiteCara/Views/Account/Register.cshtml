@model WebsiteCara.Models.NguoiDung

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="max-width: 500px;">
    <div class="card shadow border-0 p-4">
        <h3 class="fw-bold text-center mb-4 text-uppercase">Đăng Ký Tài Khoản</h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">Họ và tên</label>
                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", @required = "required", @placeholder = "Nhập họ và tên" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "email", @required = "required", @placeholder = "name@example.com" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mật khẩu</label>
                @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", @required = "required", @placeholder = "Nhập mật khẩu" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Số điện thoại</label>
                @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control", @placeholder = "Nhập số điện thoại" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Địa chỉ giao hàng</label>
                @Html.TextAreaFor(m => m.DiaChi, new { @class = "form-control", @rows = "2", @placeholder = "Nhập địa chỉ" })
            </div>

            <button type="submit" class="btn btn-dark w-100 py-2 fw-bold mt-2">ĐĂNG KÝ NAY</button>
        }

        <div class="text-center mt-3">
            <small>Đã có tài khoản? <a href="@Url.Action("Login", "Account")" class="text-decoration-none fw-bold">Đăng nhập</a></small>
        </div>
    </div>
</div>