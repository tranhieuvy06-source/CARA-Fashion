
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Account/Register.cshtml";
}

<h2>Login</h2>

@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="max-width: 450px;">
    <div class="card shadow border-0 p-4">
        <h3 class="fw-bold text-center mb-4 text-uppercase">Đăng Nhập</h3>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input type="email" name="email" class="form-control" placeholder="name@example.com" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mật khẩu</label>
                <input type="password" name="matKhau" class="form-control" placeholder="Nhập mật khẩu" required />
            </div>

            <button type="submit" class="btn btn-dark w-100 py-2 fw-bold mt-2">ĐĂNG NHẬP</button>
        }

        <div class="text-center mt-3">
            <small>Chưa có tài khoản? <a href="@Url.Action("Register", "Account")" class="text-decoration-none fw-bold">Đăng ký ngay</a></small>
        </div>
    </div>
</div>