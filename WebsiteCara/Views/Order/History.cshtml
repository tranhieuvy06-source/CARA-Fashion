@model IEnumerable<WebsiteCara.Models.DonHang>
@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h3 class="fw-bold text-uppercase mb-4">Lịch Sử Đơn Hàng Của Tôi</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Địa chỉ giao</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">#@item.MaDonHang</td>
                                <td>@string.Format("{0:dd/MM/yyyy HH:mm}", item.NgayDat)</td>
                                <td>@item.DiaChiGiaoHang</td>
                                <td class="text-end text-danger fw-bold">@string.Format("{0:N0} đ", item.TongTien)</td>
                                <td class="text-center">
                                    @if (item.TrangThai == "Chờ xử lý")
                                    {
                                        <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                    }
                                    else if (item.TrangThai == "Đã duyệt" || item.TrangThai == "Đang giao")
                                    {
                                        <span class="badge bg-primary">@item.TrangThai</span>
                                    }
                                    else if (item.TrangThai == "Hoàn thành")
                                    {
                                        <span class="badge bg-success">Hoàn thành</span>
                                    }
                                    else if (item.TrangThai == "Đã hủy")
                                    {
                                        <span class="badge bg-danger">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.TrangThai</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Details", "Order", new { id = item.MaDonHang })" class="btn btn-sm btn-outline-dark">Chi tiết</a>
                                    @if (item.TrangThai == "Chờ xử lý")
                                    {
                                        using (Html.BeginForm("Cancel", "Order", new { id = item.MaDonHang }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Bạn có chắc muốn hủy đơn hàng này?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Hủy đơn</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Bạn chưa có đơn hàng nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>