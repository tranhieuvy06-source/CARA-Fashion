@model WebsiteCara.Models.DonHang
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.MaDonHang;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-uppercase m-0">Chi Tiết Đơn Hàng #@Model.MaDonHang</h3>
        <a href="@Url.Action("History", "Order")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại lịch sử
        </a>
    </div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100 border-0 bg-light p-3">
                <h5 class="fw-bold mb-3">Thông tin khách hàng</h5>
                <p class="mb-1"><strong>Khách hàng:</strong> @(Model.NguoiDung != null ? Model.NguoiDung.HoTen : "Khách hàng")</p>
                <p class="mb-1"><strong>Số điện thoại:</strong> @(Model.NguoiDung != null ? Model.NguoiDung.DienThoai : "N/A")</p>
                <p class="mb-1"><strong>Địa chỉ:</strong> @(Model.NguoiDung != null ? Model.NguoiDung.DiaChi : "N/A")</p>
                <p class="mb-0"><strong>Email:</strong> @(Model.NguoiDung != null ? Model.NguoiDung.Email : "N/A")</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 border-0 bg-light p-3">
                <h5 class="fw-bold mb-3">Thông tin đơn hàng</h5>
                <p class="mb-1"><strong>Ngày đặt:</strong> @(Model.NgayDat.HasValue ? Model.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "")</p>
                <p class="mb-1"><strong>Trạng thái:</strong> <span class="badge @(Model.TrangThai == "Đã hủy" ? "bg-danger" : "bg-primary")">@Model.TrangThai</span></p>
                <p class="mb-2 fs-5 text-danger fw-bold"><strong>Tổng tiền:</strong> @string.Format("{0:N0} đ", Model.TongTien)</p>
                @if (Model.TrangThai == "Chờ xử lý")
                {
                    using (Html.BeginForm("Cancel", "Order", new { id = Model.MaDonHang, from = "details" }, FormMethod.Post, new { onsubmit = "return confirm('Bạn có chắc muốn hủy đơn hàng này?');" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">Hủy đơn hàng</button>
                    }
                }
            </div>
        </div>
    </div>

    <h5 class="fw-bold mb-3">Sản phẩm trong đơn hàng</h5>
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Sản phẩm</th>
                    <th>Phân loại</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ChiTietDonHangs)
                {
                    var sp = item.ChiTietSanPham;
                    <tr>
                        <td><strong>@(sp != null && sp.SanPham != null ? sp.SanPham.TenSanPham : "Sản phẩm")</strong></td>
                        <td>Size: @(sp != null && sp.KichThuoc != null ? sp.KichThuoc.TenKichThuoc : "") | Màu: @(sp != null && sp.MauSac != null ? sp.MauSac.TenMauSac : "")</td>
                        <td>@string.Format("{0:N0} đ", item.DonGia)</td>
                        <td>@item.SoLuong</td>
                        <td class="fw-bold text-danger">@string.Format("{0:N0} đ", item.DonGia * item.SoLuong)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>