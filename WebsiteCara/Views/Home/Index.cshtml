@model IEnumerable<WebsiteCara.Models.SanPham>
@{
    ViewBag.Title = "Trang chủ - Thời trang Cara";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string searchTerm = ViewBag.SearchTerm as string;
    var danhMucs = ViewBag.DanhMucs as List<WebsiteCara.Models.DanhMuc>;
    int? curDm = ViewBag.CurrentDanhMuc as int?;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}

<style>
    /* Biến màu chủ đạo: Xanh biển (Aqua Ocean Theme) */
    :root {
        --cara-primary: #0284c7;
        --cara-primary-hover: #0369a1;
        --cara-accent: #38bdf8;
        --cara-bg: #f0f9ff;
        --cara-card-bg: #ffffff;
        --cara-text: #0f172a;
        --cara-subtext: #475569;
        --cara-card-shadow: 0 10px 30px -5px rgba(2, 132, 199, 0.15);
        --cara-card-hover-shadow: 0 20px 35px -5px rgba(2, 132, 199, 0.35);
        --cara-border: #bae6fd;
    }

    [data-theme="dark"] {
        --cara-bg: #07131e;
        --cara-card-bg: #0c1e30;
        --cara-text: #f0f9ff;
        --cara-subtext: #94a3b8;
        --cara-card-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.6);
        --cara-card-hover-shadow: 0 20px 40px -5px rgba(56, 189, 248, 0.25);
        --cara-border: #164e63;
    }

    body {
        background-color: var(--cara-bg) !important;
        color: var(--cara-text) !important;
        transition: background-color 0.4s ease, color 0.4s ease;
    }

    /* Hiệu ứng Hero Banner nhẹ */
    .cara-header-badge {
        background: linear-gradient(135deg, #0284c7, #38bdf8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        letter-spacing: 1px;
    }

    /* Nút danh mục */
    .btn-ocean-filter {
        border: 1px solid var(--cara-border);
        color: var(--cara-subtext);
        background: var(--cara-card-bg);
        border-radius: 50px;
        padding: 6px 18px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

        .btn-ocean-filter:hover {
            background: var(--cara-primary);
            color: #fff;
            border-color: var(--cara-primary);
            transform: translateY(-2px);
        }

        .btn-ocean-filter.active {
            background: linear-gradient(135deg, var(--cara-primary), var(--cara-accent));
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 15px rgba(2, 132, 199, 0.4);
        }

    /* 3D Card Hover Effect */
    .product-3d-wrap {
        perspective: 1000px;
    }

    .product-card-3d {
        background: var(--cara-card-bg);
        border: 1px solid var(--cara-border);
        border-radius: 18px;
        overflow: hidden;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, border-color 0.4s ease;
        box-shadow: var(--cara-card-shadow);
        transform-style: preserve-3d;
    }

        .product-card-3d:hover {
            transform: translateY(-10px) rotateX(4deg) rotateY(-2deg);
            box-shadow: var(--cara-card-hover-shadow);
            border-color: var(--cara-accent);
        }

    /* Ảnh sản phẩm với hiệu ứng zoom */
    .card-img-container {
        position: relative;
        overflow: hidden;
        height: 290px;
    }

        .card-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

    .product-card-3d:hover .card-img-container img {
        transform: scale(1.08);
    }

    /* Huy hiệu giảm giá */
    .badge-discount {
        position: absolute;
        top: 12px;
        right: 12px;
        background: linear-gradient(135deg, #ef4444, #f97316);
        color: #fff;
        font-weight: 700;
        font-size: 0.75rem;
        padding: 5px 10px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.4);
        z-index: 2;
    }

    .card-title-3d {
        color: var(--cara-text);
        font-weight: 600;
        font-size: 1rem;
        transition: color 0.3s ease;
    }

    .product-card-3d:hover .card-title-3d {
        color: var(--cara-primary);
    }

    /* Nút xem chi tiết */
    .btn-ocean-detail {
        background: linear-gradient(135deg, #0284c7, #0ea5e9);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 16px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
    }

        .btn-ocean-detail:hover {
            background: linear-gradient(135deg, #0369a1, #0284c7);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(2, 132, 199, 0.4);
        }

    /* Phân trang */
    .ocean-pagination .page-link {
        color: var(--cara-primary);
        background: var(--cara-card-bg);
        border: 1px solid var(--cara-border);
        margin: 0 4px;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .ocean-pagination .page-item.active .page-link {
        background: linear-gradient(135deg, #0284c7, #38bdf8);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
    }

    /* Nút chỉnh Dark / Light Mode cố định */
    .theme-toggle-fab {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--cara-primary), var(--cara-accent));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(2, 132, 199, 0.4);
        cursor: pointer;
        z-index: 1050;
        border: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .theme-toggle-fab:hover {
            transform: scale(1.1) rotate(15deg);
            box-shadow: 0 12px 28px rgba(2, 132, 199, 0.6);
        }
</style>

<div class="container my-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Thanh lọc Danh mục -->
    @if (danhMucs != null && danhMucs.Any())
    {
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-5">
            <a href="@Url.Action("Index", "Home", new { searchStr = searchTerm })"
               class="btn btn-ocean-filter @(curDm == null ? "active" : "")">
                <i class="bi bi-grid-fill me-1"></i> Tất cả
            </a>
            @foreach (var dm in danhMucs)
            {
                <a href="@Url.Action("Index", "Home", new { danhMuc = dm.MaDanhMuc, searchStr = searchTerm })"
                   class="btn btn-ocean-filter @(curDm == dm.MaDanhMuc ? "active" : "")">
                    @dm.TenDanhMuc
                </a>
            }
        </div>
    }

    <!-- Tiêu đề trang -->
    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Kết quả tìm kiếm: <strong class="text-info">"@searchTerm"</strong></h4>
            <a href="@Url.Action("Index", "Home")" class="btn btn-sm btn-outline-info rounded-pill">Xem tất cả</a>
        </div>
    }
    else
    {
        <div class="text-center mb-5">
            <h2 class="cara-header-badge text-uppercase fs-2 mb-2">Bộ Sưu Tập Mới Nhất</h2>
            <p class="small text-muted">Phong cách thời trang tinh tế, mang lại trải nghiệm tươi mới</p>
            <div style="width: 60px; height: 3px; background: linear-gradient(90deg, #0284c7, #38bdf8); margin: 0 auto; border-radius: 2px;"></div>
        </div>
    }

    <!-- Danh sách sản phẩm -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                string imgUrl = item.HinhAnhChinh;
                if (string.IsNullOrEmpty(imgUrl))
                {
                    imgUrl = Url.Content("~/Content/images/default.jpg");
                }
                else if (!imgUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
                         !imgUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                {
                    imgUrl = Url.Content("~/Content/images/" + imgUrl);
                }

                <div class="col-lg-3 col-md-4 col-sm-6 product-3d-wrap">
                    <div class="card h-100 product-card-3d">
                        <div class="card-img-container">
                            @if (item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai.Value > 0 && item.GiaGoc > item.GiaKhuyenMai.Value)
                            {
                                int phanTram = (int)Math.Round((double)(item.GiaGoc - item.GiaKhuyenMai.Value) / (double)item.GiaGoc * 100);
                                <span class="badge-discount">-@phanTram%</span>
                            }
                            <img src="@imgUrl"
                                 alt="@item.TenSanPham"
                                 onerror="this.onerror=null; this.src='https://images.pexels.com/photos/1040945/pexels-photo-1040945.jpeg?auto=compress&cs=tinysrgb&w=600';" />
                        </div>

                        <div class="card-body d-flex flex-column text-center p-3">
                            <h6 class="card-title-3d text-truncate mb-2" title="@item.TenSanPham">@item.TenSanPham</h6>

                            <!-- Hiển thị Giá tiền -->
                            <div class="my-2">
                                @if (item.GiaKhuyenMai.HasValue && item.GiaKhuyenMai.Value > 0)
                                {
                                    <span class="fw-bold fs-5 text-danger me-2">@string.Format("{0:N0} đ", item.GiaKhuyenMai)</span>
                                    <span class="text-muted text-decoration-line-through small">@string.Format("{0:N0} đ", item.GiaGoc)</span>
                                }
                                else
                                {
                                    <span class="fw-bold fs-5" style="color: var(--cara-primary);">@string.Format("{0:N0} đ", item.GiaGoc)</span>
                                }
                            </div>

                            <a href="@Url.Action("Details", "Home", new { id = item.MaSanPham })" class="btn btn-ocean-detail mt-auto w-100">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Phân trang -->
        if (totalPages > 1)
        {
            <nav aria-label="Phân trang" class="mt-5">
                <ul class="pagination ocean-pagination justify-content-center">
                    <li class="page-item @(page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Home", new { searchStr = searchTerm, danhMuc = curDm, page = page - 1 })">&laquo;</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == page ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Home", new { searchStr = searchTerm, danhMuc = curDm, page = p })">@p</a>
                        </li>
                    }
                    <li class="page-item @(page >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Home", new { searchStr = searchTerm, danhMuc = curDm, page = page + 1 })">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
            <p class="fs-5 text-muted">Không tìm thấy sản phẩm nào phù hợp.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-ocean-detail px-4">Quay lại trang chủ</a>
        </div>
    }
</div>

<!-- Nút chuyển đổi Dark / Light Mode -->
<button class="theme-toggle-fab" id="themeToggleBtn" title="Chuyển chế độ Sáng / Tối">
    <span id="themeIcon" style="font-size: 1.3rem;">🌙</span>
</button>

<script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("themeToggleBtn");
            const themeIcon = document.getElementById("themeIcon");
            const currentTheme = localStorage.getItem("cara_theme") || "light";

            // Áp dụng cấu hình giao diện đã lưu
            if (currentTheme === "dark") {
                document.documentElement.setAttribute("data-theme", "dark");
                themeIcon.textContent = "☀️";
            } else {
                document.documentElement.setAttribute("data-theme", "light");
                themeIcon.textContent = "🌙";
            }

            // Sự kiện chuyển đổi Sáng / Tối
            toggleBtn.addEventListener("click", function () {
                const isDark = document.documentElement.getAttribute("data-theme") === "dark";
                if (isDark) {
                    document.documentElement.setAttribute("data-theme", "light");
                    localStorage.setItem("cara_theme", "light");
                    themeIcon.textContent = "🌙";
                } else {
                    document.documentElement.setAttribute("data-theme", "dark");
                    localStorage.setItem("cara_theme", "dark");
                    themeIcon.textContent = "☀️";
                }
            });
        });
</script>