@{
    ViewBag.Title = "Hướng dẫn chọn size";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-dark">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Hướng dẫn chọn size</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h2 class="fw-bold text-uppercase text-center mb-3">Bảng Quy Đổi Kích Thước (Size)</h2>
            <p class="text-muted text-center mb-5">Tham khảo bảng thông số dưới đây để lựa chọn trang phục vừa vặn nhất với bạn.</p>

            <!-- Bảng Size Nam -->
            <div class="card border-0 shadow-sm mb-5">
                <div class="card-header bg-dark text-white fw-bold text-uppercase">
                    1. Bảng Size Áo Nam (Áo Thun, Áo Sơ Mi, Polo)
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0 text-center align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Size</th>
                                <th>Chiều cao (cm)</th>
                                <th>Cân nặng (kg)</th>
                                <th>Vòng ngực (cm)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold">S</td>
                                <td>1m50 – 1m65</td>
                                <td>48 – 55 kg</td>
                                <td>84 – 88</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">M</td>
                                <td>1m64 – 1m69</td>
                                <td>56 – 65 kg</td>
                                <td>88 – 92</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">L</td>
                                <td>1m70 – 1m75</td>
                                <td>66 – 75 kg</td>
                                <td>92 – 96</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">XL</td>
                                <td>1m75 – 1m80</td>
                                <td>76 – 85 kg</td>
                                <td>96 – 102</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Bảng Size Quần & Đầm -->
            <div class="card border-0 shadow-sm mb-5">
                <div class="card-header bg-dark text-white fw-bold text-uppercase">
                    2. Bảng Size Quần Jeans & Đầm Nữ
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0 text-center align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Size</th>
                                <th>Vòng eo (cm)</th>
                                <th>Vòng mông (cm)</th>
                                <th>Cân nặng khuyến nghị</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold">S</td>
                                <td>62 – 66</td>
                                <td>86 – 90</td>
                                <td>40 – 47 kg</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">M</td>
                                <td>67 – 71</td>
                                <td>91 – 95</td>
                                <td>48 – 54 kg</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">L</td>
                                <td>72 – 76</td>
                                <td>96 – 100</td>
                                <td>55 – 60 kg</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">XL</td>
                                <td>77 – 81</td>
                                <td>101 – 105</td>
                                <td>61 – 68 kg</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Mẹo chọn size -->
            <div class="alert alert-info border-0 shadow-sm">
                <h6 class="fw-bold"><i class="bi bi-lightbulb me-2"></i>Mẹo nhỏ cho bạn:</h6>
                <p class="mb-0">Nếu số đo chiều cao và cân nặng của bạn nằm ở 2 size khác nhau, hãy ưu tiên chọn theo <strong>chiều cao</strong> hoặc chọn <strong>size lớn hơn</strong> để mặc thoải mái hơn nhé!</p>
            </div>
        </div>
    </div>
</div>