@using WebsiteCara.Models
@{
    var user = Session["User"] as NguoiDung;
    var cart = Session["Cart"] as List<CartItem>;
    int totalCartCount = cart != null ? cart.Sum(i => i.SoLuong) : 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - CARA BOUTIQUE</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #111111;
            --accent-gold: #c5a880;
            --bg-light: #faf9f6;
            --text-dark: #222222;
        }

        /* CONFIG DARK MODE */
        [data-theme="dark"] {
            --primary-color: #0d1117;
            --accent-gold: #38bdf8;
            --bg-light: #0d1117;
            --text-dark: #f0f6fc;
        }

            [data-theme="dark"] body,
            [data-theme="dark"] main {
                background-color: #0d1117 !important;
                color: #f0f6fc !important;
            }

            [data-theme="dark"] .navbar-luxury,
            [data-theme="dark"] .card,
            [data-theme="dark"] .bg-light,
            [data-theme="dark"] .list-group-item,
            [data-theme="dark"] .table,
            [data-theme="dark"] .modal-content,
            [data-theme="dark"] .dropdown-menu-luxury {
                background-color: #161b22 !important;
                color: #f0f6fc !important;
                border-color: #30363d !important;
            }

            [data-theme="dark"] .text-muted,
            [data-theme="dark"] .text-dark,
            [data-theme="dark"] .nav-link,
            [data-theme="dark"] .dropdown-item,
            [data-theme="dark"] .icon-btn {
                color: #c9d1d9 !important;
            }

            [data-theme="dark"] .brand-logo {
                color: #ffffff !important;
            }

            [data-theme="dark"] .form-control {
                background-color: #010409 !important;
                color: #f0f6fc !important;
                border-color: #30363d !important;
            }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #ffffff;
            color: var(--text-dark);
            letter-spacing: 0.3px;
        }

        .top-bar {
            background-color: var(--primary-color);
            color: #ffffff;
            font-size: 0.75rem;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .navbar-luxury {
            background-color: #ffffff;
            border-bottom: 1px solid #eaeaea;
        }

        .brand-logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            letter-spacing: 3px;
            color: var(--primary-color) !important;
        }

            .brand-logo span {
                color: var(--accent-gold);
            }

        .nav-luxury .nav-link {
            font-size: 0.85rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-dark) !important;
            padding: 0.5rem 1rem !important;
            transition: color 0.3s ease;
        }

            .nav-luxury .nav-link:hover {
                color: var(--accent-gold) !important;
            }

        .search-box-luxury {
            border-radius: 0;
            border: 1px solid #ddd;
            font-size: 0.85rem;
            padding: 0.4rem 0.8rem;
        }

            .search-box-luxury:focus {
                box-shadow: none;
                border-color: var(--primary-color);
            }

        .btn-search-luxury {
            border-radius: 0;
            background-color: var(--primary-color);
            color: #fff;
            border: 1px solid var(--primary-color);
            font-size: 0.85rem;
        }

            .btn-search-luxury:hover {
                background-color: var(--accent-gold);
                border-color: var(--accent-gold);
                color: #fff;
            }

        .icon-btn {
            color: var(--text-dark);
            font-size: 1.25rem;
            text-decoration: none;
            transition: color 0.3s;
        }

            .icon-btn:hover {
                color: var(--accent-gold);
            }

        .badge-luxury {
            background-color: var(--accent-gold);
            color: #ffffff;
            font-size: 0.65rem;
            font-weight: 600;
            padding: 0.25em 0.5em;
        }

        .dropdown-menu-luxury {
            border-radius: 0;
            border: 1px solid #eee;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            font-size: 0.85rem;
        }

            .dropdown-menu-luxury .dropdown-item {
                padding: 0.6rem 1.2rem;
                letter-spacing: 0.5px;
            }

                .dropdown-menu-luxury .dropdown-item:hover {
                    background-color: var(--bg-light);
                    color: var(--accent-gold);
                }

        .footer-luxury {
            background-color: var(--primary-color);
            color: #bbbbbb;
            font-size: 0.85rem;
            padding-top: 4rem;
            padding-bottom: 2rem;
        }

            .footer-luxury h5 {
                font-family: 'Playfair Display', serif;
                color: #ffffff;
                font-size: 1.1rem;
                letter-spacing: 1px;
                margin-bottom: 1.5rem;
            }

            .footer-luxury a {
                color: #bbbbbb;
                text-decoration: none;
                transition: color 0.3s;
            }

                .footer-luxury a:hover {
                    color: var(--accent-gold);
                }

        .footer-bottom {
            border-top: 1px solid #222222;
            padding-top: 1.5rem;
            margin-top: 3rem;
            font-size: 0.75rem;
        }

        /* NÚT ĐỔI SÁNG TỐI Ở BÊN TRÁI (LEFT) */
        .theme-toggle-btn {
            position: fixed;
            bottom: 25px;
            left: 25px;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background-color: var(--primary-color);
            color: #ffffff;
            border: 2px solid var(--accent-gold);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            cursor: pointer;
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: transform 0.3s ease;
        }

            .theme-toggle-btn:hover {
                transform: scale(1.1) rotate(15deg);
            }
    </style>
</head>
<body>

    <!-- Top Bar -->
    <div class="top-bar py-2 text-center">
        <div class="container">
            <span>MIỄN PHÍ VẬN CHUYỂN CHO ĐƠN HÀNG TỪ 500.000Đ | HOTLINE: 1900 6789</span>
        </div>
    </div>

    <!-- Header / Navbar -->
    <nav class="navbar navbar-expand-lg navbar-luxury sticky-top py-3">
        <div class="container">
            <a class="navbar-brand brand-logo text-uppercase me-4" href="@Url.Action("Index", "Home", new { area = "" })">
                CARA<span>.</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class="bi bi-list fs-2 text-dark"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto nav-luxury align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home", new { area = "" })">Trang chủ</a>
                    </li>

                    @if (user != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("History", "Order", new { area = "" })">Đơn hàng của tôi</a>
                        </li>

                        @* MENU QUẢN LÝ: Admin (1) và Nhân viên (3) *@
                        if (WebsiteCara.Helpers.Roles.IsBackOffice(user.MaVaiTro))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-primary fw-semibold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-sliders me-1"></i> Quản Lý
                                </a>
                                <ul class="dropdown-menu dropdown-menu-luxury">
                                    @if (user.MaVaiTro == WebsiteCara.Helpers.Roles.Admin)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("Index", "DanhMuc", new { area = "Admin" })">
                                                <i class="bi bi-tags me-2"></i>Quản lý Danh mục
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Index", "SanPham", new { area = "Admin" })">
                                            <i class="bi bi-box-seam me-2"></i>Quản lý Sản phẩm
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Index", "DonHang", new { area = "Admin" })">
                                            <i class="bi bi-receipt me-2"></i>Quản lý Đơn hàng
                                        </a>
                                    </li>
                                    @if (user.MaVaiTro == WebsiteCara.Helpers.Roles.Admin)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("Index", "NguoiDung", new { area = "Admin" })">
                                                <i class="bi bi-people me-2"></i>Quản lý Người dùng
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    }
                </ul>

                <!-- Form Tìm kiếm -->
                <form class="d-flex me-lg-4 my-2 my-lg-0" action="@Url.Action("Index", "Home", new { area = "" })" method="get">
                    <div class="input-group">
                        <input type="text" name="searchStr" class="form-control search-box-luxury" placeholder="Tìm kiếm sản phẩm..." value="@Request.QueryString["searchStr"]" />
                        <button class="btn btn-search-luxury px-3" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Giỏ hàng & Tài khoản -->
                <div class="d-flex align-items-center gap-3 mt-2 mt-lg-0">
                    <a href="@Url.Action("Index", "Cart", new { area = "" })" class="icon-btn position-relative me-2" title="Giỏ hàng">
                        <i class="bi bi-bag"></i>
                        @if (totalCartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-circle badge-luxury">
                                @totalCartCount
                            </span>
                        }
                    </a>

                    @if (user != null)
                    {
                        <div class="dropdown">
                            <a class="icon-btn dropdown-toggle d-flex align-items-center gap-1 text-decoration-none" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span class="fs-7 fw-medium d-none d-xl-inline ms-1">@user.HoTen</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-luxury dropdown-menu-end">
                                <li class="px-3 py-2 border-bottom">
                                    <small class="text-muted d-block">Xin chào,</small>
                                    <span class="fw-bold text-dark">@user.HoTen</span>
                                </li>
                                <li>
                                    <a class="dropdown-item text-danger mt-1" href="@Url.Action("Logout", "Account", new { area = "" })">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account", new { area = "" })" class="icon-btn" title="Đăng nhập">
                            <i class="bi bi-person"></i>
                        </a>
                        <a href="@Url.Action("Register", "Account", new { area = "" })" class="btn btn-outline-dark btn-sm rounded-0 text-uppercase fw-semibold px-3 ms-1" style="font-size: 0.75rem; letter-spacing: 1px;">
                            Đăng ký
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="min-vh-100 py-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-luxury">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-uppercase brand-logo text-white mb-3" style="font-size: 1.5rem;">CARA<span>.</span></h5>
                    <p class="pe-lg-4 text-secondary">
                        Thương hiệu thời trang mang đến sự tinh tế, sang trọng và phong cách hiện đại.
                    </p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5 class="text-uppercase">Khám Phá</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="@Url.Action("Index", "Home", new { area = "" })">TRANG CHỦ</a></li>
                        <li><a href="@Url.Action("Index", "Cart", new { area = "" })">Giỏ hàng</a></li>
                        <li><a href="@Url.Action("History", "Order", new { area = "" })">ĐƠN HÀNG CỦA TÔI</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-uppercase">Hỗ Trợ</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="@Url.Action("ChinhSachDoiTra", "Home", new { area = "" })">Chính sách đổi trả</a></li>
                        <li><a href="@Url.Action("HuongDanChonSize", "Home", new { area = "" })">Hướng dẫn chọn size</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-uppercase">Liên Hệ</h5>
                    <p class="text-secondary small">Hotline: 1900 6789<br>Email: cskh@cara.vn</p>
                </div>
            </div>
            <div class="footer-bottom text-center text-secondary">
                <p class="mb-0">&copy; @DateTime.Now.Year CARA BOUTIQUE. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <!-- NÚT ĐỔI SÁNG TỐI (GÓC DƯỚI BÊN TRÁI) -->
    <button class="theme-toggle-btn" id="btnThemeToggle" type="button" title="Chuyển chế độ Sáng / Tối">
        <span id="themeIcon">🌙</span>
    </button>

    <!-- ================= CHATBOX AI TƯ VẤN (GÓC DƯỚI BÊN PHẢI) ================= -->
    <style>
        .ai-chat-btn {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background-color: var(--primary-color);
            color: #ffffff;
            border: 2px solid var(--accent-gold);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
            cursor: pointer;
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            transition: transform 0.3s ease, background-color 0.3s ease;
        }

            .ai-chat-btn:hover {
                transform: scale(1.1);
                background-color: var(--accent-gold);
                color: #ffffff;
            }

        .ai-chat-box {
            position: fixed;
            bottom: 95px;
            right: 25px;
            width: 350px;
            max-width: 90vw;
            height: 480px;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 1050;
            border: 1px solid #eaeaea;
        }

        .ai-chat-header {
            background-color: var(--primary-color);
            color: #ffffff;
            padding: 14px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--accent-gold);
        }

        .ai-chat-body {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            background-color: var(--bg-light);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .ai-msg {
            max-width: 82%;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13.5px;
            line-height: 1.45;
        }

            .ai-msg.bot {
                background-color: #ffffff;
                color: var(--text-dark);
                align-self: flex-start;
                border: 1px solid #eee;
            }

            .ai-msg.user {
                background-color: var(--primary-color);
                color: #ffffff;
                align-self: flex-end;
            }

        .ai-quick-options {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 4px;
        }

        .ai-quick-btn {
            background-color: #ffffff;
            border: 1px solid var(--accent-gold);
            color: var(--text-dark);
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .ai-quick-btn:hover {
                background-color: var(--accent-gold);
                color: #ffffff;
            }

        .ai-chat-footer {
            padding: 10px;
            background-color: #ffffff;
            border-top: 1px solid #eee;
            display: flex;
            gap: 8px;
        }
    </style>

    <button class="ai-chat-btn" id="btnToggleAiChat" type="button" title="Hỗ trợ trực tuyến AI CARA">
        💬
    </button>

    <div class="ai-chat-box" id="aiChatBox">
        <div class="ai-chat-header">
            <span class="fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.85rem;">Cara Tư Vấn</span>
            <button type="button" class="btn-close btn-close-white small" id="btnCloseAiChat"></button>
        </div>

        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-msg bot">
                Xin chào! CARA AI Assistant có thể giúp gì cho bạn về sản phẩm, khuyến mãi hay phương thức thanh toán?
            </div>
            <div class="ai-quick-options">
                <button class="ai-quick-btn" onclick="sendAiQuickMsg('Phương thức thanh toán?')">Thanh toán thế nào?</button>
                <button class="ai-quick-btn" onclick="sendAiQuickMsg('Phí vận chuyển bao nhiêu?')">Phí vận chuyển?</button>
                <button class="ai-quick-btn" onclick="sendAiQuickMsg('Thời gian giao hàng?')">Thời gian giao hàng?</button>
            </div>
        </div>

        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" class="form-control search-box-luxury" placeholder="Nhập câu hỏi..." onkeypress="handleAiKeyPress(event)" />
            <button type="button" class="btn btn-search-luxury px-3" onclick="sendAiUserMsg()">Gửi</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
                // --- 1. SCRIPT ĐỔI SÁNG TỐI ---
                document.addEventListener('DOMContentLoaded', function () {
                    const btnTheme = document.getElementById('btnThemeToggle');
                    const iconTheme = document.getElementById('themeIcon');
                    const savedTheme = localStorage.getItem('cara_theme') || 'light';

                    function applyTheme(theme) {
                        if (theme === 'dark') {
                            document.documentElement.setAttribute('data-theme', 'dark');
                            if (iconTheme) iconTheme.textContent = '☀️';
                        } else {
                            document.documentElement.removeAttribute('data-theme');
                            if (iconTheme) iconTheme.textContent = '🌙';
                        }
                    }

                    applyTheme(savedTheme);

                    if (btnTheme) {
                        btnTheme.addEventListener('click', function () {
                            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                            const newTheme = isDark ? 'light' : 'dark';
                            localStorage.setItem('cara_theme', newTheme);
                            applyTheme(newTheme);
                        });
                    }
                });

                // --- 2. SCRIPT CHATBOX AI ---
                const btnToggleAi = document.getElementById('btnToggleAiChat');
                const btnCloseAi = document.getElementById('btnCloseAiChat');
                const aiChatBox = document.getElementById('aiChatBox');

                if (btnToggleAi && btnCloseAi && aiChatBox) {
                    btnToggleAi.addEventListener('click', function () {
                        if (aiChatBox.style.display === 'flex') {
                            aiChatBox.style.display = 'none';
                        } else {
                            aiChatBox.style.display = 'flex';
                            document.getElementById('aiChatInput').focus();
                        }
                    });

                    btnCloseAi.addEventListener('click', function () {
                        aiChatBox.style.display = 'none';
                    });
                }

                function handleAiKeyPress(e) {
                    if (e.key === 'Enter') {
                        sendAiUserMsg();
                    }
                }

                function sendAiUserMsg() {
                    const input = document.getElementById('aiChatInput');
                    const text = input.value.trim();
                    if (text !== '') {
                        appendAiMsg(text, 'user');
                        input.value = '';
                        processAiResponse(text);
                    }
                }

                function sendAiQuickMsg(text) {
                    appendAiMsg(text, 'user');
                    processAiResponse(text);
                }

                function appendAiMsg(text, sender) {
                    const body = document.getElementById('aiChatBody');
                    const msg = document.createElement('div');
                    msg.className = 'ai-msg ' + sender;
                    msg.innerText = text;
                    body.appendChild(msg);
                    body.scrollTop = body.scrollHeight;
                }

                function processAiResponse(query) {
                    let reply = "Cảm ơn bạn đã liên hệ! Bạn có thể đặt mua hàng trực tiếp hoặc liên hệ hotline 1900 6789 để phục vụ nhanh nhất.";
                    const q = query.toLowerCase();

                    if (q.includes('thanh toán') || q.includes('qr') || q.includes('chuyển khoản')) {
                        reply = "CARA hỗ trợ thanh toán khi nhận hàng (COD) và chuyển khoản qua quét mã QR MBBank tự động khi đặt hàng.";
                    } else if (q.includes('vận chuyển') || q.includes('ship') || q.includes('phí')) {
                        reply = "CARA miễn phí vận chuyển cho mọi đơn hàng từ 500.000đ. Phí giao hàng tiêu chuẩn là 30.000đ.";
                    } else if (q.includes('thời gian') || q.includes('bao lâu') || q.includes('mấy ngày')) {
                        reply = "Thời gian giao hàng trung bình từ 1-3 ngày làm việc tùy thuộc vào địa chỉ nhận hàng của bạn.";
                    }

                    setTimeout(function () {
                        appendAiMsg(reply, 'bot');
                    }, 500);
                }
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>