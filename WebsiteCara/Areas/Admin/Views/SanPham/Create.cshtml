@model WebsiteCara.Models.SanPham

@{
    ViewBag.Title = "Thêm Sản Phẩm Mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-uppercase">Thêm Sản Phẩm Mới</h3>
        <a href="@Url.Action("Index", "SanPham", new { area = "Admin" })" class="btn btn-outline-secondary">← Quay lại</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            @using (Html.BeginForm("Create", "SanPham", new { area = "Admin" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.MaDanhMuc, (SelectList)ViewBag.DanhMucList, "-- Chọn danh mục --", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.MaDanhMuc, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.TenSanPham, new { @class = "form-control", required = "required", placeholder = "Nhập tên sản phẩm..." })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Giá gốc (VNĐ) <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.GiaGoc, new { @class = "form-control", type = "number", min = "0", step = "1000", required = "required", placeholder = "Ví dụ: 350000" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Giá khuyến mãi (VNĐ)</label>
                    @Html.TextBoxFor(m => m.GiaKhuyenMai, new { @class = "form-control", type = "number", min = "0", step = "1000", placeholder = "Để trống nếu không giảm giá" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Hình ảnh sản phẩm</label>
                    <input type="file" name="HinhAnhFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Định dạng jpg, png, gif, webp - tối đa 5MB. Ảnh được lưu vào ~/Content/images/</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mô tả sản phẩm</label>
                    @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "4", placeholder = "Mô tả chất liệu, kiểu dáng..." })
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg fw-bold">Lưu Sản Phẩm</button>
                </div>
            }
        </div>
    </div>
</div>