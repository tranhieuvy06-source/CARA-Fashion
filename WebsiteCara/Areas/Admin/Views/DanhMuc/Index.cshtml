@model IEnumerable<WebsiteCara.Models.DanhMuc>
@{
    ViewBag.Title = "Quản lý Danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h3 class="fw-bold text-uppercase mb-4">Quản Lý Danh Mục Sản Phẩm</h3>

    <div class="row">
        <!-- Form Thêm Danh Mục -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">Thêm Danh Mục Mới</div>
                <div class="card-body">
                    @using (Html.BeginForm("Create", "DanhMuc", new { area = "Admin" }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                            <input type="text" name="TenDanhMuc" class="form-control" placeholder="Ví dụ: Áo Sơ Mi, Quần Jean..." required />
                        </div>
                        <button type="submit" class="btn btn-success w-100 fw-bold">+ Thêm Danh Mục</button>
                    }
                </div>
            </div>
        </div>

        <!-- Bảng Danh Sách Danh Mục -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center">Mã</th>
                                <th>Tên danh mục</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@item.MaDanhMuc</td>
                                        <td class="fw-bold">@item.TenDanhMuc</td>
                                        <td class="text-center">
                                            @using (Html.BeginForm("Delete", "DanhMuc", new { area = "Admin", id = item.MaDanhMuc }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Bạn có chắc chắn muốn xóa danh mục này?');" }))
                                            {
                                                <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">Chưa có danh mục nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>